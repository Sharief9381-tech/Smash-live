# Server Configuration
PORT=5001
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ponjjw1.mongodb.net/smashlive?appName=Cluster0

# Authentication
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRE=24h

# Frontend (for CORS)
FRONTEND_URL=http://localhost:8080

# Fast2SMS (OTP delivery)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Backend API URL (set in Vercel env vars after deploying backend to Render)
VITE_API_URL=https://your-render-service.onrender.com/api
